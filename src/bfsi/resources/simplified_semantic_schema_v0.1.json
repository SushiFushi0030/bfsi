{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BFSI V0.1 Simplified Semantic Schema v0.1",
  "description": "Independent Bulldozer model output; Task 04 frozen schema is unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comment_id",
    "relevance",
    "targets",
    "market_stance",
    "emotion",
    "action_intent",
    "creator_attitude",
    "sarcasm",
    "confidence",
    "summary"
  ],
  "properties": {
    "comment_id": {
      "type": "string",
      "minLength": 1
    },
    "relevance": {
      "type": "string",
      "enum": [
        "financial",
        "social",
        "other",
        "unclear"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "raw_name",
          "normalized_name",
          "target_type"
        ],
        "properties": {
          "raw_name": {
            "type": "string",
            "minLength": 1
          },
          "normalized_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_type": {
            "type": "string",
            "enum": [
              "asset",
              "market",
              "macro",
              "policy",
              "person",
              "creator",
              "other"
            ]
          }
        }
      }
    },
    "market_stance": {
      "type": "string",
      "enum": [
        "bullish",
        "bearish",
        "neutral",
        "mixed",
        "unclear",
        "not_applicable"
      ]
    },
    "emotion": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "optimistic",
          "pessimistic",
          "anxious",
          "fearful",
          "excited",
          "frustrated",
          "angry",
          "confused",
          "humorous",
          "neutral"
        ]
      }
    },
    "action_intent": {
      "type": "string",
      "enum": [
        "buy",
        "add",
        "hold",
        "reduce",
        "sell",
        "wait",
        "ask_advice",
        "no_action",
        "unclear",
        "not_applicable"
      ]
    },
    "creator_attitude": {
      "type": "string",
      "enum": [
        "positive",
        "negative",
        "neutral",
        "mixed",
        "unclear",
        "not_applicable"
      ]
    },
    "sarcasm": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unclear"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
